---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog" description="All posts.">
  <section>
    <h1 class="text-2xl font-bold tracking-tight mb-8 text-zinc-900 dark:text-zinc-50">
      Posts
    </h1>

    {posts.length === 0 && (
      <p class="text-zinc-500 dark:text-zinc-400">No posts yet. Check back soon.</p>
    )}

    <ul class="space-y-10">
      {posts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });

        return (
          <li>
            <a href={`/blog/${post.id}`} class="group block no-underline">
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  class="w-full rounded-lg mb-3 aspect-video object-cover"
                />
              )}
              <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-50 group-hover:text-[var(--color-brand)] dark:group-hover:text-[var(--color-brand-dark)] transition-colors">
                {post.data.title}
              </h2>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
                {formattedDate}
              </p>
              <p class="text-zinc-600 dark:text-zinc-300 mt-2 text-sm leading-relaxed">
                {post.data.description}
              </p>
            </a>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-3">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}`}
                    class="text-xs px-2.5 py-1 rounded-full no-underline font-medium
                           bg-zinc-100 text-zinc-600 hover:bg-zinc-200
                           dark:bg-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-700 transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</Layout>
